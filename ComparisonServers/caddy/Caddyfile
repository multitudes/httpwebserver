    #     root /var/www/html
    # }
    # File upload size limit
    handle_path /upload {
        request_body {
            max_size 10MB
        }
    }

    # Handle uploads directory
    @uploads {
        path /uploads/*
    }
    handle @uploads {
        file_server {
            browse off
        }
    }

