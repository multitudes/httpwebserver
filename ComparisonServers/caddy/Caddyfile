:4244 {
    root * /var/www/html
    file_server

	# Redirect /go to /here
    redir /go /here 301

	    # Handle CGI scripts
    @upload path /cgi-bin/upload.pl
    cgi @upload /usr/bin/perl /cgi-bin/upload.pl

    @hello path /cgi-bin/hello.pl
    cgi @hello /usr/bin/perl /cgi-bin/hello.pl
    # cgi @hello /usr/bin/perl {
